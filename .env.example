# AI Provider Selection ("google" or "digitalocean")
AI_PROVIDER=google

# Google GenAI / Gemma 4 Configuration
# Acquire your Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemma 4 Model Identifier (e.g. gemma-4-31b-it, gemma-4-26b-a4b-it)
GEMMA_MODEL=gemma-4-31b-it
FALLBACK_MODEL=gemma-4-26b-a4b-it

# DigitalOcean GenAI Serverless Inference Configuration (Open-Weight Models)
# DigitalOcean Inference API: https://inference.do-ai.run/v1
# Model Access Key acquired from DigitalOcean GenAI Console
DO_INFERENCE_ENDPOINT=https://inference.do-ai.run/v1
DO_INFERENCE_TOKEN=
DO_MODEL=meta-llama/Meta-Llama-3.2-11B-Vision-Instruct
DO_FALLBACK_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Persistence (Optional - if empty, local JSON storage is used automatically)
MONGODB_URI=
DATABASE_NAME=resq_vision_db

# Application Environment
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Google GenAI / Gemma 4 Configuration
# Acquire your Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemma 4 Model Identifier (e.g. gemma-4-31b-it, gemma-4-26b-a4b-it)
GEMMA_MODEL=gemma-4-31b-it
FALLBACK_MODEL=gemma-4-26b-a4b-it

# Persistence (Optional - if empty, local JSON storage is used automatically)
MONGODB_URI=
DATABASE_NAME=resq_vision_db

# Application Environment
APP_ENV=development
HOST=0.0.0.0
PORT=8000
